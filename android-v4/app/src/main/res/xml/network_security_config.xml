<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- السماح بحركة مرور غير مشفرة (HTTP) لجميع الشبكات — للتطوير والاختبار الميداني -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
