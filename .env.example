# Telescope Settings
# في بيئة التطوير: true
# في بيئة الإنتاج: false أو قم بحذف هذا السطر لتعطيل Telescope
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
# ============================================
# إعدادات Rclone لـ Google Drive
# ============================================

#####################################################
# ── 1) إصلاح مسار ملف إعدادات rclone للنسخ الاحتياطي (يمرّر --config صراحةً) ──
BACKUP_RCLONE_CONFIG=/var/www/.config/rclone/rclone.conf

# ── 2) تفعيل النسخ الاحتياطي المجدول (اختياري: إن أردت أرشفة OneDrive تلقائية) ──
BACKUP_SCHEDULE_ENABLED=true

# ── 3) عامل الطابور: اختر واحداً فقط ──
QUEUE_CONNECTION=database        # + شغّل queue:work عبر supervisor
#QUEUE_CONNECTION=sync           # أو هذا إن لم تستخدم supervisor

# ── 4) رفع مفاتيح Google Drive API (مطلوبة لفرع API/تسمية المجلدات) ──
# ضع Folder ID لمجلد داخل Shared Drive مشترك مع حساب الخدمة
GOOGLE_DRIVE_GENERAL_REGISTRATION_PARENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ── 5) تصحيح تعليق مضلل: USE_RCLONE_FOR_UPLOADS=true تعني "تفعيل" لا "تعطيل" ──
# تفعيل Rclone لرفع المرفقات إلى Google Drive
USE_RCLONE_FOR_UPLOADS=true

# ── 6) تأكد من المسارات الفعلية (عدّلها حسب نتائج which/ls) ──
# RCLONE_PATH=/usr/bin/rclone
# WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf

###############################################################

# مسار ملف Rclone التنفيذي
# Windows: C:\rclone-v1.72.1-windows-amd64\rclone.exe
# Ubuntu: /usr/bin/rclone
RCLONE_PATH=/usr/bin/rclone


QUEUE_CONNECTION=database           # إن لم يكن محدداً
# مسار ملف إعدادات Rclone (مهم جداً على الاستضافة)
# يجب أن يكون قابل للقراءة من www-data
RCLONE_CONFIG=/var/www/.config/rclone/rclone.conf
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# اسم Remote في Rclone config
RCLONE_REMOTE_NAME=alhayahorphans

# المجلد الجذر في Google Drive لرفع المرفقات
RCLONE_ROOT_FOLDER=temp

# تعطيل Rclone واستخدام التخزين المحلي
USE_RCLONE_FOR_UPLOADS=true

# تفعيل التخزين المحلي
USE_LOCAL_STORAGE_FOR_UPLOADS=true



# ── Backup / Media Archive to OneDrive ──
BACKUP_ONEDRIVE_PATH=onedrive:uploades
BACKUP_MEDIA_ARCHIVE_ENABLED=true
BACKUP_ARCHIVE_UPLOADS=true
BACKUP_ARCHIVE_ATTACHMENTS=true
BACKUP_EXCLUDE_ARCHIVED_MEDIA=true

BACKUP_DATABASES=aso
BACKUP_PATH=.backups
BACKUP_KEEP_COUNT=5
BACKUP_MIN_FREE_SPACE_MB=5120
BACKUP_LOCK_TIMEOUT_MINUTES=600
BACKUP_TIMEOUT_MINUTES=480

BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_EXCLUDE_EXTRA=node_modules,.git

BACKUP_SCHEDULE_TIME=02:00


WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf

BROWSERSHOT_CHROME_PATH=/usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
BROWSERSHOT_NO_SANDBOX=true


# android-v4 Phase 7 � Staged Cutover (false = disable legacy v3 sync scheduling at runtime)
LEGACY_SYNC_ENABLED=false

# NSMS REST v2 (https://send.nsms.ps)
NSMS_BASE_URL=https://send.nsms.ps/api/rest/v2
NSMS_TOKEN=6ac1f20f4b06f
NSMS_SENDER=
NSMS_COUNTRY_CODE=970