# Speedtest CLI Configuration
SPEEDTEST_TIMEOUT=120
SPEEDTEST_MAX_ATTEMPTS=3
SPEEDTEST_CACHE_ENABLED=true
SPEEDTEST_CACHE_DURATION=300
SPEEDTEST_CLI_PATH=
SPEEDTEST_SERVER_ID=
SPEEDTEST_INTERFACE=
SPEEDTEST_VERBOSE_LOGGING=false

# Speedtest Fallback Settings
SPEEDTEST_FALLBACK_DOWNLOAD_MIN=10
SPEEDTEST_FALLBACK_DOWNLOAD_MAX=100
SPEEDTEST_FALLBACK_UPLOAD_MIN=5
SPEEDTEST_FALLBACK_UPLOAD_MAX=50
SPEEDTEST_FALLBACK_PING_MIN=10
SPEEDTEST_FALLBACK_PING_MAX=100

# Speedtest Rate Limiting
SPEEDTEST_RATE_LIMIT_ENABLED=true
SPEEDTEST_RATE_LIMIT_MAX_REQUESTS=5
SPEEDTEST_RATE_LIMIT_PER_MINUTES=60

# Speedtest Security
SPEEDTEST_ALLOWED_IPS=
SPEEDTEST_REQUIRE_AUTH=false
SPEEDTEST_MAX_CONCURRENT_TESTS=3

# Speedtest Results Storage
SPEEDTEST_STORE_RESULTS=false
SPEEDTEST_CLEANUP_AFTER_DAYS=30
